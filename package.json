{
  "name": "star-island",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint . && vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:gallery": "tsx scripts/smoke.ts",
    "sync:gallery": "tsx scripts/sync-gallery.ts",
    "smoke:rig": "tsx scripts/smoke-rig.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "element-plus": "^2.11.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-vue-next": "^0.468.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.16.0",
    "vue": "^3.5.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
